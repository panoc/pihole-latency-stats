Description=Pi-hole Latency Stats analysis (profile %i)
After=pihole-FTL.service

[Service]
Type=oneshot
ExecStart=/opt/phls/phls run %i --quiet --timer
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=30min
EOF
    cat > "$UNITDIR/phls@.timer" <<'EOF'
[Unit]
Description=Pi-hole Latency Stats schedule (profile %i)

[Timer]
# first run 30 s after the timer starts / 3 min after boot; the repeat interval
# (OnUnitActiveSec) comes from the profile's drop-in: phls@<profile>.timer.d/interval.conf
OnActiveSec=30s
OnBootSec=3min
AccuracySec=10s

[Install]
WantedBy=timers.target
EOF
    cat > "$UNITDIR/phls-apply.path" <<EOF
[Unit]
Description=Pi-hole Latency Stats: watch for settings changed in the dashboard

[Path]
PathExistsGlob=$PHLS_PENDING/*.conf
Unit=phls-apply.service

[Install]
WantedBy=paths.target
EOF
    cat > "$UNITDIR/phls-apply.service" <<'EOF'
[Unit]
Description=Pi-hole Latency Stats: apply settings changed in the dashboard

[Service]
Type=oneshot
ExecStart=/opt/phls/phls apply
Nice=10
TimeoutStartSec=30min
EOF
    cat > "$UNITDIR/phls-update-check.service" <<'EOF'
