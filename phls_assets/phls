[Install]
WantedBy=timers.target
EOF
}

write_web_units() {
    local port="$1" v6=""
    [ -e /proc/net/if_inet6 ] && v6="\$SERVER[\"socket\"] == \"[::]:$port\" { }"
    cat > "$PHLS_ETC/lighttpd.conf" <<EOF
# PHLS dashboard web server (its own lighttpd instance: Pi-hole and any other web server are untouched).
# Written by phls setup; changes are overwritten on update. Port: change WEB_PORT in $CONF, then run: sudo phls update
server.modules        = ( "mod_access", "mod_alias", "mod_cgi", "mod_setenv" )
server.document-root  = "$PHLS_WEB"
server.port           = $port
server.username       = "www-data"
server.groupname      = "www-data"
server.tag            = "phls"
server.errorlog-use-syslog = "enable"
server.max-connections = 32
server.max-request-size = 64
$v6
index-file.names      = ( "dash.html" )
dir-listing.activate  = "disable"
url.access-deny       = ( "~", ".inc", ".conf", ".tmp" )
mimetype.assign       = ( ".html" => "text/html; charset=utf-8", ".json" => "application/json; charset=utf-8",
                          ".css" => "text/css; charset=utf-8", ".js" => "text/javascript; charset=utf-8",
                          ".png" => "image/png", ".ico" => "image/x-icon", "" => "text/plain; charset=utf-8" )
setenv.add-response-header = ( "X-Content-Type-Options" => "nosniff", "Referrer-Policy" => "same-origin" )
alias.url             = ( "/api/" => "$OPT/cgi/" )
\$HTTP["url"] =~ "^/api/" { cgi.assign = ( "" => "" ) }
EOF
    cat > "$UNITDIR/phls-web.service" <<EOF
[Unit]
Description=Pi-hole Latency Stats dashboard (lighttpd on port $port)
After=network.target

[Service]
ExecStartPre=/usr/sbin/lighttpd -tt -f $PHLS_ETC/lighttpd.conf
ExecStart=/usr/sbin/lighttpd -D -f $PHLS_ETC/lighttpd.conf
ExecReload=/bin/kill -USR1 \$MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
}

install_web_libs() {
    local l
    for l in "${LIB_URLS[@]}"; do
        local tmp; tmp=$(mktemp)
        if curl -fsL --retry 2 --connect-timeout 15 "${l%%|*}" -o "$tmp" 2>/dev/null && [ -s "$tmp" ]; then install -m 644 "$tmp" "$PHLS_WEB/${l##*|}"
        elif [ ! -s "$PHLS_WEB/${l##*|}" ]; then warn "Could not download ${l##*|}; the dashboard will load it from the internet instead."; fi
        rm -f "$tmp"
    done
}

# --- upgrade from v4 (~/phls + cron) ---
find_v4() {
    local d cand=() h
    h=$(getent passwd "${SUDO_USER:-root}" | cut -d: -f6)
    for d in "$h/phls" /root/phls /home/*/phls; do
        [ -f "$d/pihole_stats.sh" ] || continue
        local x dup=0; for x in "${cand[@]}"; do [ "$x" -ef "$d" ] && dup=1; done
        [ $dup -eq 0 ] && cand+=("$d")
    done
    [ ${#cand[@]} -gt 0 ] && printf '%s\n' "${cand[@]}"
    return 0
}

old_cron_lines() {   # user<TAB>line for every crontab line of an old install
    local u
    for u in $( { echo root; ls /var/spool/cron/crontabs 2>/dev/null; } | sort -u); do
        crontab -l -u "$u" 2>/dev/null | grep -E 'PHLS-ID:|pihole_stats\.sh|phls_version_check' | grep -v '^[[:space:]]*#' | sed "s/^/$u\t/"
    done | sort -u
}

disable_old_cron() {
    local u tmp
    for u in $( { echo root; ls /var/spool/cron/crontabs 2>/dev/null; } | sort -u); do
        crontab -l -u "$u" 2>/dev/null | grep -qE 'PHLS-ID:|pihole_stats\.sh|phls_version_check' || continue
        tmp=$(mktemp)
        crontab -l -u "$u" 2>/dev/null | sed -E '/^[[:space:]]*#/! { /PHLS-ID:|pihole_stats\.sh|phls_version_check/ s/^/#PHLS-v4-disabled# / }' > "$tmp"
        crontab -u "$u" "$tmp" && ok "Old cron jobs of user $u disabled (commented out)"
        rm -f "$tmp"
    done
}

migrate_v4() {
    local d="$1" old_dash p f freq every ucc line
    old_dash=$(sed -n 's/^DASH_PATH="\(.*\)"[[:space:]]*$/\1/p' "$d/.phls_install.conf" 2>/dev/null | head -n 1)
    [ -z "$old_dash" ] && [ -f /var/www/html/phls/dash.html ] && old_dash=/var/www/html/phls
    step "Moving your settings from $d"
    local list=()
    if [ -s "$d/cron/cron_profiles.db" ]; then
        while IFS='|' read -r p freq _ f; do
            phls_valid_profile_name "$p" || continue
            list+=("$p|$freq|${f:-$d/cron/$p.conf}")
        done < "$d/cron/cron_profiles.db"
    fi
    [ ${#list[@]} -eq 0 ] && [ -f "$d/pihole_stats.conf" ] && list+=("default|5m|$d/pihole_stats.conf")
    for line in "${list[@]}"; do
        IFS='|' read -r p freq f <<< "$line"
        local dst; dst=$(profile_conf "$p")
        if [ -e "$dst" ]; then say "  profile $p: already there, kept"; continue; fi
        [ -r "$f" ] || { warn "  profile $p: $f not found, skipped"; continue; }
        new_profile "$p" ""
        # copy the old values of every setting the engine knows (parsed, never executed)
        local k v
        for k in DBfile ENABLE_UNBOUND MAX_DB_DAYS ENABLE_MATH_ALL_TIME L01 L02 L03 L04 L05 L06 L07 L08 L09 L10 L11 L12 L13 L14 L15 L16 L17 L18 L19 L20 \
                 MIN_LATENCY_CUTOFF MAX_LATENCY_CUTOFF MAX_HISTORY_ENTRIES ENABLE_MATH_12H ENABLE_MATH_24H ENABLE_MATH_7D ENABLE_MATH_30D \
                 ENABLE_UPSTREAM_DIST ENABLE_UPSTREAM_MATH_ALL_TIME ENABLE_MANUAL_REFINEMENT UPSTREAM_DIST_MIN_CUTOFF ENABLE_CACHE; do
            grep -q "^$k=" "$f" || continue
            v=$(phls_get "$f" "$k")
            if [ "$k" = "DBfile" ] || [ "$k" = "ENABLE_MANUAL_REFINEMENT" ] || phls_valid "$k" "$v" >/dev/null; then
                [[ "$v" == *[\"\'\\\`\$]* ]] || phls_set "$dst" "$k" "$v"
            fi
        done
        local cargs; cargs=$(sed -n "s/^CONFIG_ARGS=['\"]\(.*\)['\"].*/\1/p" "$f" | head -n 1)
        if [[ "$cargs" =~ ^-(e?dm)[[:space:]]+\"?([A-Za-z0-9.*_-]+)\"?$ ]]; then sed -i "s|^CONFIG_ARGS=.*|CONFIG_ARGS='-${BASH_REMATCH[1]} ${BASH_REMATCH[2]}'|" "$dst"
        elif [ -n "$cargs" ]; then warn "  profile $p: extra arguments '$cargs' not carried over (only domain filters are)"; fi
        every="${freq%[ms]}"; [[ "$freq" == *s ]] && every=1
        [[ "$every" =~ ^[0-9]+$ ]] && [ "$every" -ge 1 ] && [ "$every" -le 1440 ] || every=5
        phls_set "$dst" RUN_EVERY "$every"
        ucc=false; old_cron_lines | grep -F "PHLS-ID:$p" | grep -q -- '-ucc' && ucc=true
        [ "$p" = "default" ] && old_cron_lines | grep -- '-dash' | grep -E "\"?default\"?" | grep -q -- '-ucc' && ucc=true
        phls_set "$dst" UCC "$ucc"
        # history, snapshot and cache
        if [ -n "$old_dash" ]; then
            local x; for x in "dash_$p.json" "dash_$p.h.json"; do
                [ -s "$old_dash/$x" ] && [ ! -e "$PHLS_WEB/$x" ] && cp -p "$old_dash/$x" "$PHLS_WEB/$x" && chown www-data:www-data "$PHLS_WEB/$x" 2>/dev/null
            done
        fi
        [ -s "$d/cache/phls_$p.db" ] && [ ! -e "$PHLS_LIB/cache/phls_$p.db" ] && cp "$d/cache/phls_$p.db" "$PHLS_LIB/cache/" && chown root:root "$PHLS_LIB/cache/phls_$p.db"
        ok "  profile $p (every $every min$([ "$ucc" = true ] && echo ', Unbound cache counts'))"
    done
    MIGRATED_FROM="$d"; MIGRATED_DASH="$old_dash"
}

redirect_old_dashboard() {   # leave a forwarding page where the old dashboard was
    local old="$1" url="$2"
    [ -n "$old" ] && [ -f "$old/dash.html" ] && [ -n "$url" ] || return 0
    [ -f "$old/dash.html.v4" ] || cp -p "$old/dash.html" "$old/dash.html.v4"
    cat > "$old/dash.html" <<EOF
<!DOCTYPE html><html><head><meta charset="utf-8"><title>PHLS has moved</title>
<script>var p=new URLSearchParams(location.search).get('p');var u='http://'+location.hostname+':${url##*:}'.replace(/\/$/,'')+'/'+(p?'?p='+encodeURIComponent(p):'');location.replace(u);</script>
</head><body>The dashboard has moved to <a href="$url">$url</a>.</body></html>
EOF
}

cmd_setup() {
    need_root
    local SRC="$SELF_DIR" f
    for f in pihole_stats.sh phls lib/settings.sh cgi/settings dash.html favicon.png version; do
        [ -s "$SRC/$f" ] || die "Release files incomplete: $f missing in $SRC"
    done
    [ "$SRC" -ef "$OPT" ] && die "Run setup from the downloaded release folder (or use: sudo phls update)."

    say "${B}Pi-hole Latency Stats $PHLS_VERSION — setup${N}"
    step "Checking this system"
    detect_pihole
    ok "Pi-hole $PIHOLE_VER, database $PIHOLE_DB ($PIHOLE_DAYS days)"
    have_systemd || die "systemd is required."
    local fresh=true; [ -r "$CONF" ] && fresh=false
    local v4=(); mapfile -t v4 < <(find_v4)
    [ "$fresh" = true ] && [ ${#v4[@]} -gt 0 ] && ok "Found PHLS v4 in: ${v4[*]} (its settings and history will be moved over)"
    command -v unbound-control >/dev/null 2>&1 && ok "Unbound found: its stats will be included"

    # --- the questions ---
    local want_dash="$(conf_get DASHBOARD)"
    if [ "$fresh" = true ]; then
        step "Questions"
        say "The web dashboard shows charts of your DNS latency in the browser and lets you change settings there."
        if ask_yn "Install the web dashboard?" Y; then want_dash=yes; else want_dash=no; fi
    fi
    local cron_lines; cron_lines=$(old_cron_lines)
    local disable_cron=false
    if [ -n "$cron_lines" ]; then
        say ""; say "These old cron jobs run PHLS v4 (the new version schedules itself):"
        printf '%s\n' "$cron_lines" | sed 's/^/   /'
        ask_yn "Disable them? (they are commented out, not deleted)" Y && disable_cron=true
    fi

    # --- packages ---
    step "Installing what is needed"
    local pk=()
    command -v sqlite3 >/dev/null 2>&1 || pk+=(sqlite3)
    command -v curl >/dev/null 2>&1 || pk+=(curl)
    command -v flock >/dev/null 2>&1 || pk+=(util-linux)
    command -v ionice >/dev/null 2>&1 || pk+=(util-linux)
    command -v awk >/dev/null 2>&1 || pk+=(mawk)
    local installed_lighttpd="$(conf_get INSTALLED_LIGHTTPD)"
    if [ "$want_dash" = yes ] && ! command -v lighttpd >/dev/null 2>&1 && [ ! -x /usr/sbin/lighttpd ]; then
        pk+=(lighttpd); installed_lighttpd=yes
    fi
    if [ ${#pk[@]} -gt 0 ]; then
        # keep apt from starting the stock lighttpd service on port 80 (Pi-hole's port)
        local prc=false
        if [[ " ${pk[*]} " == *" lighttpd "* ]] && [ ! -e /usr/sbin/policy-rc.d ]; then
            printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d; chmod 755 /usr/sbin/policy-rc.d; prc=true
        fi
        apt_install $(printf '%s\n' "${pk[@]}" | sort -u)
        [ "$prc" = true ] && rm -f /usr/sbin/policy-rc.d
        if [[ " ${pk[*]} " == *" lighttpd "* ]]; then
            # PHLS runs its own lighttpd instance; the stock one would fight Pi-hole for port 80
            systemctl disable --now lighttpd.service >/dev/null 2>&1
        fi
    fi
    ok "Packages ready"

    # --- files ---
    step "Installing files"
    mkdir -p "$OPT/lib" "$OPT/cgi" "$PHLS_PROFILES" "$PHLS_LIB/cache" "$PHLS_STATUS" "$PHLS_PENDING" "$LOGDIR"
    install -m 755 "$SRC/pihole_stats.sh" "$OPT/pihole_stats.sh"
    install -m 755 "$SRC/phls" "$OPT/phls"
    install -m 644 "$SRC/lib/settings.sh" "$OPT/lib/settings.sh"
    install -m 755 "$SRC/cgi/settings" "$OPT/cgi/settings"
    install -m 644 "$SRC/version" "$OPT/version"
    ln -sf "$OPT/phls" /usr/local/bin/phls
    chmod 755 "$PHLS_ETC" "$PHLS_PROFILES" "$PHLS_LIB" "$PHLS_STATUS" "$PHLS_LIB/cache"
    chown root:root "$PHLS_LIB/cache"; chmod 700 "$PHLS_LIB/cache"
    if getent group www-data >/dev/null; then chown root:www-data "$PHLS_PENDING"; chmod 2770 "$PHLS_PENDING"; else chmod 700 "$PHLS_PENDING"; fi

    # --- global settings file ---
    local port; port=$(conf_get WEB_PORT)
    [ "$want_dash" = yes ] && { [[ "$port" =~ ^[0-9]+$ ]] || port=$(pick_port); }
    {
        echo "# Pi-hole Latency Stats - global settings (written by phls setup)"
        echo "# Profile settings are in $PHLS_PROFILES/<name>.conf  (easiest: sudo phls edit)"
        echo "DASHBOARD=\"$want_dash\""
        echo "WEB_PORT=\"$port\""
        echo "PIHOLE_DB=\"$PIHOLE_DB\""
        echo "PIHOLE_DAYS=\"$PIHOLE_DAYS\""
        echo "PIHOLE_API=\"$PIHOLE_API\""
        echo "PIHOLE_API_INSECURE=\"$PIHOLE_API_INSECURE\""
        echo "INSTALLED_LIGHTTPD=\"${installed_lighttpd:-no}\""
        local inst; inst=$(conf_get INSTALLED); echo "INSTALLED=\"${inst:-$(date '+%F')}\""
    } > "$CONF.tmp"
    chmod 644 "$CONF.tmp"; mv -f "$CONF.tmp" "$CONF"

    # --- dashboard files ---
    if [ "$want_dash" = yes ]; then
        mkdir -p "$PHLS_WEB"
        install -m 644 "$SRC/dash.html" "$PHLS_WEB/dash.html"
        install -m 644 "$SRC/favicon.png" "$PHLS_WEB/favicon.png"
        [ -s "$PHLS_WEB/version" ] || install -m 644 "$SRC/version" "$PHLS_WEB/version"
        install_web_libs
        chown -R www-data:www-data "$PHLS_WEB" 2>/dev/null; chmod 755 "$PHLS_WEB"
    else
        mkdir -p "$PHLS_WEB"   # snapshots are still written (dash_<profile>.json)
    fi

    # --- profiles ---
    if [ "$fresh" = true ] && [ ${#v4[@]} -gt 0 ]; then
        local d; for d in "${v4[@]}"; do migrate_v4 "$d"; done
    fi
    [ "$disable_cron" = true ] && disable_old_cron
    if [ -z "$(profiles)" ]; then new_profile default ""; ok "Profile 'default' created"; fi
    # keep profiles pointing at the current database / dashboard folder
    local p; for p in $(profiles); do
        f=$(profile_conf "$p")
        [ "$(phls_get "$f" DASH_DIR)" = "$PHLS_WEB" ] || phls_set "$f" DASH_DIR "$PHLS_WEB"
        grep -q '^RUN_EVERY=' "$f" || phls_set "$f" RUN_EVERY "$PHLS_DEFAULTS_RUN_EVERY"
        grep -q '^UCC=' "$f" || phls_set "$f" UCC "$PHLS_DEFAULTS_UCC"
        grep -q '^UPSTREAM_DIST_MIN_CUTOFF=' "$f" || phls_set "$f" UPSTREAM_DIST_MIN_CUTOFF "4"
        grep -q '^EXCLUDE_PTR=' "$f" || phls_set "$f" EXCLUDE_PTR "true"
        grep -q '^UPSTREAM_BY_PROVIDER=' "$f" || phls_set "$f" UPSTREAM_BY_PROVIDER "false"
        local k; for k in PROFILE_TYPE FILTER_DOMAIN REPORT_RANGE REPORT_FROM REPORT_TO REPORT_COUNT REPORT_NX REPORT_UNBOUND; do
            grep -q "^$k=" "$f" || phls_set "$f" "$k" "${PHLS_DEFAULT[$k]}"
        done
        # 5.0 beta 1-11 kept a domain filter as extra arguments: now it is the "Domains" setting
        local cargs; cargs=$(sed -n "s/^CONFIG_ARGS=['\"]\(.*\)['\"][[:space:]]*$/\1/p" "$f" | head -n 1)
        if [[ "$cargs" =~ ^-(e?dm)[[:space:]]+\"?([A-Za-z0-9.*_-]{1,253})\"?$ ]]; then
            local dv="${BASH_REMATCH[2]}"
            [ "${BASH_REMATCH[1]}" = "dm" ] && [[ "$dv" != *'*'* ]] && dv="*$dv*"   # -dm = "contains"
            phls_set "$f" FILTER_DOMAIN "$dv" && sed -i "s|^CONFIG_ARGS=.*|CONFIG_ARGS=''|" "$f"
        fi
    done

    # --- services ---
    step "Setting up the schedule$([ "$want_dash" = yes ] && echo ' and the web server')"
    write_units
    if [ "$want_dash" = yes ]; then
        write_web_units "$port"
        /usr/sbin/lighttpd -tt -f "$PHLS_ETC/lighttpd.conf" >/dev/null 2>&1 || warn "lighttpd rejected $PHLS_ETC/lighttpd.conf"
    else
        systemctl disable --now phls-web.service >/dev/null 2>&1; rm -f "$UNITDIR/phls-web.service" "$PHLS_ETC/lighttpd.conf"
    fi
    systemctl daemon-reload
    for p in $(profiles); do [ "$(phls_profile_type "$p")" = report ] && continue; write_timer_dropin "$p"; done
    systemctl daemon-reload
    for p in $(profiles); do
        if [ "$(phls_profile_type "$p")" = report ]; then unschedule_profile "$p"; continue; fi
        systemctl enable "phls@$p.timer" >/dev/null 2>&1; systemctl restart "phls@$p.timer"; write_next_run "$p" 30
    done
    systemctl enable --now phls-apply.path phls-update-check.timer >/dev/null 2>&1
    if [ "$want_dash" = yes ]; then
        systemctl enable phls-web.service >/dev/null 2>&1
        systemctl restart phls-web.service
        sleep 1
        systemctl is-active --quiet phls-web.service && ok "Web server running on port $port" || warn "The web server did not start: sudo systemctl status phls-web"
    fi
    refresh_auth_info force
    ok "Profiles scheduled: $(for p in $(profiles); do [ "$(phls_profile_type "$p")" = report ] || printf '%s ' "$p"; done)"
    ( cmd_check_update ) >/dev/null 2>&1 &

    # --- first run ---
    step "$([ "$fresh" = true ] && echo "First analysis" || echo "Running the analysis once")"
    [ -s "$PHLS_WEB/dash_default.json" ] || say "This reads the whole Pi-hole database once (up to a minute on a Pi Zero with millions of queries)..."
    local first; first=$(profiles | grep -x default || profiles | head -n 1)
    cmd_run "$first" --quiet --wait && ok "Analysis done" || warn "The first run failed: sudo phls logs $first"

    local url; url=$(dash_url)
    if [ -n "$MIGRATED_DASH" ] && [ -n "$url" ]; then redirect_old_dashboard "$MIGRATED_DASH" "$url"; fi

    say ""
    say "${G}${B}✔ Pi-hole Latency Stats $PHLS_VERSION is installed.${N}"
    [ -n "$url" ] && say "  Dashboard:  ${C}${B}$url${N}"
    say "  Manage:     ${C}sudo phls${N}   (status, settings, profiles, update, uninstall)"
    if [ -n "$MIGRATED_FROM" ]; then
        say "  Your old v4 folder is untouched: $MIGRATED_FROM"
        say "  When everything works, delete it with:  sudo rm -rf $MIGRATED_FROM"
        [ -n "$MIGRATED_DASH" ] && say "  The old dashboard address now forwards to the new one."
    fi
}

# ------------------------------------------------------------------------------
# Uninstall
# ------------------------------------------------------------------------------
cmd_uninstall() {
    need_root
    ask_yn "Remove Pi-hole Latency Stats?" N || return 0
    local keep=true
    ask_yn "Also delete your settings and dashboard history?" N && keep=false
    local p
    for p in $(profiles); do systemctl disable --now "phls@$p.timer" >/dev/null 2>&1; rm -rf "$UNITDIR/phls@$p.timer.d"; done
    systemctl disable --now phls-web.service phls-apply.path phls-update-check.timer >/dev/null 2>&1
    rm -f "$UNITDIR"/phls@.service "$UNITDIR"/phls@.timer "$UNITDIR"/phls-apply.path "$UNITDIR"/phls-apply.service \
          "$UNITDIR"/phls-update-check.service "$UNITDIR"/phls-update-check.timer "$UNITDIR"/phls-web.service
    systemctl daemon-reload
    local lt; lt=$(conf_get INSTALLED_LIGHTTPD)
    rm -f /usr/local/bin/phls "$PHLS_ETC/lighttpd.conf"
    if [ "$keep" = true ]; then
        rm -f "$PHLS_WEB"/dash.html "$PHLS_WEB"/favicon.png "$PHLS_WEB"/version "$PHLS_WEB"/bootstrap.min.css "$PHLS_WEB"/chart.js "$PHLS_WEB"/chartjs-plugin-datalabels.js
        rm -rf "$PHLS_PENDING" "$PHLS_STATUS"
        say "Kept: settings in $PHLS_ETC, history in $PHLS_WEB, cache in $PHLS_LIB (a new install picks them up)."
    else
        rm -rf "$PHLS_ETC" "$PHLS_LIB" "$PHLS_WEB" "$LOGDIR"
    fi
    if [ "$lt" = yes ] && ask_yn "Remove the lighttpd package (PHLS installed it)?" Y; then
        DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq lighttpd >/dev/null 2>&1 && ok "lighttpd removed"
    fi
    rm -rf "$OPT"
    ok "Pi-hole Latency Stats removed."
}

# ------------------------------------------------------------------------------
# Menu
# ------------------------------------------------------------------------------
cmd_menu() {
    need_root
    while true; do
        say ""; cmd_status; say ""
        say " ${B}1${N}) Change settings      ${B}4${N}) Add a profile        ${B}7${N}) Update PHLS"
        say " ${B}2${N}) Run analysis now     ${B}5${N}) Delete a profile     ${B}8${N}) Uninstall"
        say " ${B}3${N}) Show settings        ${B}6${N}) Logs of a profile    ${B}0${N}) Exit"
        local a; a=$(ask_val "Choose" "0")
        case "$a" in
            1) cmd_edit ;;
            2) cmd_run "$(pick_profile "Profile")" ;;
            3) cmd_show "$(pick_profile "Profile")" ;;
            4) cmd_add "" ;;
            5) cmd_delete "" ;;
            6) cmd_logs "$(pick_profile "Profile")" ;;
            7) cmd_update; return ;;
            8) cmd_uninstall; return ;;
            0|q|"") return 0 ;;
        esac
    done
}

usage() {
    sed -n '3,15p' "$SELF" | sed 's/^# \{0,1\}//'
}

# ------------------------------------------------------------------------------
CMD="${1:-}"; shift 2>/dev/null || true
ARGS=(); for a in "$@"; do case "$a" in --yes|-y) ASSUME_YES=true ;; *) ARGS+=("$a") ;; esac; done
set -- "${ARGS[@]}"
case "$CMD" in
    "")            if [ -n "$TTY_IN" ] && [ "$EUID" -eq 0 ]; then cmd_menu; else cmd_status; fi ;;
    menu)          cmd_menu ;;
    status)        cmd_status ;;
    run)           cmd_run "$@" ;;
    apply)         cmd_apply ;;
    show)          cmd_show "$@" ;;
    set)           cmd_set "$@" ;;
    edit|settings) cmd_edit "$@" ;;
    add)           cmd_add "$@" ;;
    delete|remove) cmd_delete "$@" ;;
    clear)         cmd_clear "$@" ;;
    reset)         cmd_reset ;;
    logs|log)      cmd_logs "$@" ;;
    url)           dash_url && echo || die "No dashboard installed." ;;
    update)        cmd_update "$@" ;;
    check-update)  cmd_check_update ;;
    setup|install) cmd_setup ;;
    uninstall)     cmd_uninstall ;;
    version|-v|--version) echo "$PHLS_VERSION${PHLS_BUILD:+-$PHLS_BUILD}" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
