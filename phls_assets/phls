Description=Pi-hole Latency Stats: check for a new version
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/phls/phls check-update
Nice=19
EOF
    cat > "$UNITDIR/phls-update-check.timer" <<'EOF'
